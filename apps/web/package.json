{
  "name": "@atomo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8788",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@atomo/ai-gateway": "workspace:*",
    "@atomo/credits": "workspace:*",
    "@atomo/db": "workspace:*",
    "@atomo/prompt-engine": "workspace:*",
    "@atomo/publisher": "workspace:*",
    "@atomo/timeline": "workspace:*",
    "@opennextjs/cloudflare": "1.20.17",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "wrangler": "4.165.0"
  }
}
