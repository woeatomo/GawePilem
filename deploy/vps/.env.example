# Domain untuk endpoint worker (arahkan A record ke IP VPS), mis. worker.contoh.id
WORKER_DOMAIN=
# Sama dengan WORKER_TOKEN di web (wrangler secret)
WORKER_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
APP_URL=https://<domain-web>

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=atomo-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Domain publik bucket R2 (custom domain atau r2.dev)
S3_PUBLIC_URL=https://media.contoh.id

AI_MOCK=0
WORKER_CONCURRENCY=4
RENDER_CONCURRENCY=1
