# Env web app (Next.js). Untuk Cloudflare: rahasia via `wrangler secret put`, sisanya di wrangler.jsonc vars.
# Worker job (apps/jobs) memakai apps/jobs/.dev.vars (lihat .dev.vars.example).

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya server. Jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci enkripsi AES-256-GCM untuk API key BYOK, token OAuth, dan secret platform: openssl rand -base64 32
# WAJIB sama di web & apps/jobs. Jangan diganti setelah ada data (secret jadi tidak terbaca).
ENCRYPTION_KEY=

# ---------- Antrean job (Cloudflare Worker apps/jobs) ----------
WORKER_URL=http://127.0.0.1:8787
# Token rahasia bersama web <-> apps/jobs: openssl rand -hex 24
WORKER_TOKEN=

# ---------- Provider AI ----------
# Key asli diisi di /admin/secrets (superadmin + 2FA, terenkripsi di DB). Nilai env hanya cadangan.
OPENCODE_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
# 1 = semua kategori AI memakai adapter tiruan (dev/demo tanpa key, tanpa biaya provider)
AI_MOCK=1

# ---------- Publish ----------
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_DAILY_UPLOADS=100
# 1 setelah project Google lolos audit (sebelum itu YouTube memaksa upload private)
YOUTUBE_AUDITED=0

# ---------- Pembayaran (Midtrans Snap) ----------
# 1 = top-up disimulasikan (dev/demo). Produksi: 0. Server key bisa diisi di /admin/secrets.
PAYMENTS_SANDBOX=1
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=0
