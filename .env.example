# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya server & worker. Jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci enkripsi AES-256-GCM untuk API key BYOK & token OAuth: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- Antrean ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Provider AI (key platform untuk mode Saldo) ----------
OPENCODE_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
# 1 = semua kategori AI memakai adapter tiruan (dev/demo tanpa key, tanpa biaya provider)
AI_MOCK=1

# ---------- Storage aset besar ----------
# local = file di LOCAL_MEDIA_DIR disajikan lewat /api/media (dev). s3 = S3-compatible + CDN (produksi).
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=/absolute/path/to/.media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------- Publish ----------
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_DAILY_UPLOADS=100
# 1 setelah project Google lolos audit (sebelum itu YouTube memaksa upload private)
YOUTUBE_AUDITED=0

# ---------- Pembayaran ----------
# 1 = top-up disimulasikan (dev/demo). Produksi: 0, top-up lewat webhook payment gateway.
PAYMENTS_SANDBOX=1

# ---------- Worker ----------
WORKER_CONCURRENCY=4
RENDER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
